 struct zis_entry {
     uint8_t reg;
     const struct device *dev;
+    uint8_t buttons;
+    bool needs_reset;
 };
 
 #define ZIS_ENTRY(n) {.reg = DT_INST_REG_ADDR(n), .dev = DEVICE_DT_GET(DT_DRV_INST(n))},
 
-static const struct zis_entry proxy_inputs[] = {DT_INST_FOREACH_STATUS_OKAY(ZIS_ENTRY)};
+static struct zis_entry proxy_inputs[] = {DT_INST_FOREACH_STATUS_OKAY(ZIS_ENTRY)};
+
+int trackpad_deliver_frame(uint8_t reg, const struct trackpad_wire_frame *frame) {
+    for (size_t i = 0; i < ARRAY_SIZE(proxy_inputs); i++) {
+        struct zis_entry *proxy = &proxy_inputs[i];
+        if (proxy->reg != reg) {
+            continue;
+        }
+        if (!proxy->needs_reset && frame->x == 0 && frame->y == 0 &&
+            proxy->buttons == frame->buttons) {
+            return 0;
+        }
+        int ret;
+        if (proxy->needs_reset) {
+            /* Clear an uncommitted listener sample before replaying a failed frame. */
+            ret = input_report(proxy->dev, TRACKPAD_INPUT_RESET_TYPE, 0, 0, false, K_FOREVER);
+            if (ret < 0) {
+                LOG_ERR("Failed to reset partial trackpad input: %d", ret);
+                return ret;
+            }
+            proxy->needs_reset = false;
+        }
+        for (int button = 0; button < 5; button++) {
+            if ((proxy->buttons ^ frame->buttons) & BIT(button)) {
+                ret = input_report_key(proxy->dev, INPUT_BTN_0 + button,
+                                            !!(frame->buttons & BIT(button)), false, K_FOREVER);
+                if (ret < 0) {
+                    goto failed;
+                }
+            }
+        }
+        ret = input_report_rel(proxy->dev, INPUT_REL_X, frame->x, false, K_FOREVER);
+        if (ret < 0) {
+            goto failed;
+        }
+        ret = input_report_rel(proxy->dev, INPUT_REL_Y, frame->y, true, K_FOREVER);
+        if (ret < 0) {
+            goto failed;
+        }
+        proxy->buttons = frame->buttons;
+        return 0;
+
+failed:
+        proxy->needs_reset = true;
+        LOG_ERR("Failed to deliver complete trackpad input: %d", ret);
+        return ret;
+    }
+    LOG_ERR("No split input for trackpad frame %u", reg);
+    return -ENODEV;
+}
 
