+static int pinnacle_write_checked(const struct device *dev, uint8_t addr, uint8_t value) {
+    int ret = pinnacle_write(dev, addr, value);
+    if (ret < 0) {
+        LOG_ERR("Failed to write register %02x: %d", addr, ret);
+        return ret;
+    }
+    uint8_t actual;
+    ret = pinnacle_seq_read(dev, addr, &actual, 1);
+    if (ret < 0) {
+        LOG_ERR("Failed to verify register %02x: %d", addr, ret);
+        return ret;
+    }
+    if (actual != value) {
+        LOG_ERR("Register %02x verification failed: %02x != %02x", addr, actual, value);
+        return -EIO;
+    }
+    return 0;
+}
+
+static int pinnacle_wait(const struct device *dev, uint8_t addr, uint8_t mask,
+                         uint8_t expected, int timeout_ms) {
+    int64_t deadline = k_uptime_get() + timeout_ms;
+    do {
+        uint8_t value;
+        int ret = pinnacle_seq_read(dev, addr, &value, 1);
+        if (ret < 0) {
+            LOG_ERR("Failed polling register %02x: %d", addr, ret);
+            return ret;
+        }
+        if ((value & mask) == expected) {
+            return 0;
+        }
+        k_msleep(1);
+    } while (k_uptime_get() < deadline);
+    LOG_ERR("Timed out polling register %02x", addr);
+    return -ETIMEDOUT;
+}
