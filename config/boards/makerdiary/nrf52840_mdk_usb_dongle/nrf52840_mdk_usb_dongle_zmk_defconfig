CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_GPIO=y

CONFIG_ZMK_USB=y
CONFIG_ZMK_BLE=y
CONFIG_BUILD_OUTPUT_UF2=y

# Persist bonds/peripheral addresses; the stock board falls back to SETTINGS_NONE
CONFIG_MPU_ALLOW_FLASH_WRITE=y
CONFIG_NVS=y
CONFIG_SETTINGS_NVS=y
CONFIG_FLASH=y
CONFIG_FLASH_PAGE_LAYOUT=y
CONFIG_FLASH_MAP=y

# The stock board's USB CDC ACM console would add a serial interface beside ZMK's HID
CONFIG_BOARD_SERIAL_BACKEND_CDC_ACM=n
