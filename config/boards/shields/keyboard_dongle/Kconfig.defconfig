# Default config selections when keyboard_dongle shield is used

if SHIELD_KEYBOARD_DONGLE

config ZMK_KEYBOARD_NAME
    default "Keyboard Dongle"

config ZMK_SPLIT
    default y

config ZMK_SPLIT_ROLE_CENTRAL
    default y

config ZMK_USB
    default y

# Define peripheral count for split BLE relay module
config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
    default 2

# Enable the dongle-side automatic bond recovery. Catches BLE security
# failures with a split peripheral and clears the stale bond so the next
# connection re-pairs cleanly. See config/dongle_split_recovery/.
config DONGLE_BOND_AUTOHEAL
    default y

endif # SHIELD_KEYBOARD_DONGLE
