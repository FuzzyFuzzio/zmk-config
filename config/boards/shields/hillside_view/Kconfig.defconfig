if SHIELD_HILLSIDE_VIEW_LEFT

config ZMK_KEYBOARD_NAME
    default "Hillside View"

endif # SHIELD_HILLSIDE_VIEW_LEFT

if SHIELD_HILLSIDE_VIEW_LEFT || SHIELD_HILLSIDE_VIEW_RIGHT

config ZMK_SPLIT
    default y

# Both halves are peripherals when using external dongle
# Do NOT set ZMK_SPLIT_ROLE_CENTRAL - absence means peripheral role

# Enable the peripheral-side bond clear escape hatch. There are two
# trigger modes (see config/dongle_split_recovery/):
#   * Boot window: hold the trigger combo while powering the half on.
#   * Panic hold: hold the trigger combo for several seconds at any
#     time during normal operation.
# Either fires the same bt_unpair. Only runs on peripherals; the
# Kconfig depends-on excludes hillside_view_left_central.
config PERIPHERAL_BOOT_BONDCLEAR
    default y

# Trigger combo = the two outer corner keys (top + bottom of the
# outermost column on each half). The matrix transform numbers the
# global keymap left-to-right, top-to-bottom, six keys per row per
# half. The right half's overlay sets col-offset = <6>, so a
# peripheral only emits position events in its own slice of the
# global map - hence per-half defaults below.
if SHIELD_HILLSIDE_VIEW_LEFT
# Left top-outer-left (RC(0,0)) and bottom-outer-left (RC(2,0)).
config PERIPHERAL_BOOT_BONDCLEAR_POS_A
    default 0
config PERIPHERAL_BOOT_BONDCLEAR_POS_B
    default 24
endif

if SHIELD_HILLSIDE_VIEW_RIGHT
# Right top-outer-right (RC(0,11)) and bottom-outer-right (RC(2,11)).
config PERIPHERAL_BOOT_BONDCLEAR_POS_A
    default 11
config PERIPHERAL_BOOT_BONDCLEAR_POS_B
    default 35
endif

config ZMK_RGB_UNDERGLOW
    select WS2812_STRIP
    select SPI

config ZMK_DISPLAY
    select LV_FONT_MONTSERRAT_26

if ZMK_MOUSE

config I2C
  default y

endif # ZMK_MOUSE

if ZMK_DISPLAY

config ZMK_DISPLAY_BLANK_ON_IDLE
  default n

config SPI
    default y

config LS0XX
    default y

# config ZMK_WIDGET_WPM_STATUS
#   default y if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1

endchoice

endif # LVGL

endif # SHIELD_HILLSIDE_VIEW_LEFT || SHIELD_HILLSIDE_VIEW_RIGHT
