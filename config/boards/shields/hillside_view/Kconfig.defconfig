if SHIELD_HILLSIDE_VIEW_LEFT

config ZMK_KEYBOARD_NAME
    default "Hillside View"

endif # SHIELD_HILLSIDE_VIEW_LEFT

if SHIELD_HILLSIDE_VIEW_LEFT || SHIELD_HILLSIDE_VIEW_RIGHT

config ZMK_SPLIT
    default y

# Both halves are peripherals when using external dongle
# Do NOT set ZMK_SPLIT_ROLE_CENTRAL - absence means peripheral role

# Enable the peripheral-side boot-time bond clear escape hatch. Holding
# the configured trigger combo while powering the half on wipes its
# stored bond so it pairs fresh with the dongle on next connect.
# This only runs on peripherals (the depends-on in the Kconfig blocks
# it on hillside_view_left_central). See config/dongle_split_recovery/.
config PERIPHERAL_BOOT_BONDCLEAR
    default y

config ZMK_RGB_UNDERGLOW
    select WS2812_STRIP
    select SPI

config ZMK_DISPLAY
    select LV_FONT_MONTSERRAT_26

if ZMK_MOUSE

config I2C
  default y

endif # ZMK_MOUSE

if ZMK_DISPLAY

config ZMK_DISPLAY_BLANK_ON_IDLE
  default n

config SPI
    default y

config LS0XX
    default y

# config ZMK_WIDGET_WPM_STATUS
#   default y if !ZMK_SPLIT || ZMK_SPLIT_ROLE_CENTRAL

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1
endchoice

endif # ZMK_DISPLAY

if LVGL

config LV_Z_VDB_SIZE
    default 64

config LV_DPI_DEF
    default 148

config LV_Z_BITS_PER_PIXEL
    default 1

choice LV_COLOR_DEPTH
    default LV_COLOR_DEPTH_1

endchoice

endif # LVGL

endif # SHIELD_HILLSIDE_VIEW_LEFT || SHIELD_HILLSIDE_VIEW_RIGHT
